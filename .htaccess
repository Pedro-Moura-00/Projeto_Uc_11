RewriteEngine On

# Não aplica a regra se for um arquivo real (como css, js, imagens)
RewriteCond %{REQUEST_FILENAME} !-f
# Não aplica a regra se for um diretório real
RewriteCond %{REQUEST_FILENAME} !-d

# Redireciona tudo o que sobrar para o index.php, passando o caminho na variável 'url'
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]